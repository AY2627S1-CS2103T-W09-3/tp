<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Let the list cell supply the card width instead of expanding to fit its text. -->
<!-- Use the content's computed preferred height, including when the font changes. -->
<HBox id="cardPane" minWidth="0" prefWidth="0"
      minHeight="-Infinity" maxHeight="-Infinity"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox fx:id="cardContent" alignment="CENTER_LEFT" spacing="1" minWidth="0" minHeight="68" HBox.hgrow="ALWAYS">
    <padding>
      <!-- Keep taller platform fonts compact without limiting their computed height. -->
      <Insets top="1" right="10" bottom="1" left="15" />
    </padding>
    <HBox fx:id="identityRow" spacing="4" alignment="CENTER_LEFT" minWidth="0"
          minHeight="22">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Ensures that the index is never truncated. -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" styleClass="cell_big_label" minWidth="0"
             maxWidth="Infinity" textOverrun="ELLIPSIS" HBox.hgrow="ALWAYS" />
      <Label fx:id="noteIndicator" styleClass="note-indicator" contentDisplay="GRAPHIC_ONLY"
             accessibleRole="TEXT" accessibleText="Has note" alignment="CENTER"
             minWidth="20" prefWidth="20" maxWidth="20" minHeight="20" prefHeight="20" maxHeight="20"
             visible="false" managed="false">
        <graphic>
          <SVGPath content="M1,0 H7 L10,3 V12 H1 Z M7,0 V3 H10 M3,6 H8 M3,9 H8"
                   styleClass="note-icon" mouseTransparent="true" />
        </graphic>
        <tooltip>
          <Tooltip text="Has note" />
        </tooltip>
      </Label>
      <Label fx:id="role" styleClass="role-badge">
        <minWidth>
          <!-- Keeps the role badge fully visible when the client's name is long. -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
    </HBox>
    <HBox fx:id="contactRow" spacing="4" alignment="CENTER_LEFT" minWidth="0"
          minHeight="16">
      <Label fx:id="phone" styleClass="cell_small_label">
        <minWidth>
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="contactSeparator" text="·" styleClass="cell_small_label" />
      <Label fx:id="email" styleClass="cell_small_label" minWidth="0"
             maxWidth="Infinity" textOverrun="ELLIPSIS" HBox.hgrow="ALWAYS" />
    </HBox>
    <StackPane fx:id="tags" alignment="CENTER_LEFT" minWidth="0" minHeight="16" />
    <Label fx:id="requirementsSummary" styleClass="cell_small_label" minWidth="0" maxWidth="Infinity"
           minHeight="16" textOverrun="ELLIPSIS" wrapText="false"
           visible="false" managed="false" />
  </VBox>
</HBox>
